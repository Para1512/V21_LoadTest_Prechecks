# --- Run the portal (pick one) ---
# Python (works if Node is not installed):  pip install -r requirements.txt
#                                          python app.py
#   Or double-click start-portal.bat (uses Python if found, else Node).
# Node:  npm install   then   npm start
#
# Web server (optional)
# PORT=3000
# HOST=0.0.0.0
# OPEN_BROWSER=1   set to 0 to stop auto-opening a browser on Windows
#
# VDI: set MobaXterm to the real install path on that machine
# MOBAXTERM_PATH=C:\Program Files\MobaXterm\MobaXterm.exe
#
# Optional SSH bounce wording (server bounce / health tasks)
# TUX_BOUNCE_COMMAND=get tuxedo bounce status
#
# Log space check (Task 3) — NPE CGI usage + auto-clean when >70%
# NPE_SERVICES_CGI_BASE=http://npe-services:8888/cgi-bin
# LOG_CLEAN_APILINK_CGI=http://npe-services:8888/cgi-bin/cleanPetAPILinkLogs
# LOG_SPACE_REQUEST_TIMEOUT_MS=120000
#
# Server health (Task 5) — PET1-V21 CGI (fetched server-side only; status shown in portal)
# NPE_SERVICES_CGI_BASE=http://npe-services:8888/cgi-bin
# PET1_V21_HEALTH_CGI=PET1-V21
# PET1_V21_HEALTH_URL=http://npe-services:8888/cgi-bin/PET1-V21
# PET_HEALTH_REQUEST_TIMEOUT_MS=60000
#
# Results window — Tuxedo IO collect + download
# TUX_IO_REPORT_URL=http://npe-services:8888/cgi-bin/TUX_IO_REPORT.py
# TUX_IO_REPORT_TIMEOUT_MS=180000
# TUX_IO_ABNORMAL_RESPONSE_SECONDS=60
#
# LG disk check — optional explicit WMI credentials (Python wmi / DCOM)
# LG_WMI_DOMAIN=YOURDOMAIN
# LG_WMI_USER=youraccount
# LG_WMI_PASSWORD=your-password
#
# Server bounce — ReqCentral "Check status" fetches this browse URL + issue key (Task 4)
# REQCENTRAL_BROWSE_BASE=https://reqcentral.com/browse
#
# Task 1 — Data loading (VTS API on 2244/2245)
VTS1_URL=http://vm0196ptlrg001:2244/
